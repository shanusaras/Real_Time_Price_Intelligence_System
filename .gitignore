# ========================
# ETL Directory
# ========================

# Outputs - Only track specific report files
etl/output/*
!etl/output/README.md
!etl/output/ETL_VALIDATION_REPORT.md
!etl/output/etl_stats_*.json

# Data - Ignore all except README
etl/data/*
!etl/data/README.md

# Monitoring - Only track README
etl/monitoring/*
!etl/monitoring/README.md

# Sensitive configs
etl/config.py
etl/config.py.backup
etl/*.env
etl/*.pem
etl/*.key

# Temporary and cache files
etl/*.tmp
etl/*.temp
etl/*.swp
etl/*.swo
etl/.DS_Store

